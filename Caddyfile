# Caddy serves this whole repo as a static website.
# It listens on port 8080 (tell Railway "8080" as the port).
:8080

root * /usr/share/caddy
encode gzip

# --- Backend "apps" in their own Railway services ---
# Each app is its own Railway service, reached over Railway's private
# network and shown at yourdomain.com/appname.

# Continuous Learning (github.com/mtooks/continuous-learning)
redir /learn /learn/
handle_path /learn/* {
    reverse_proxy continuous-learning.railway.internal:8080
}

file_server
